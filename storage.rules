rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny for all unspecified paths
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'joaomuatxissombo22@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    function isValidPdfUpload() {
      return request.resource != null &&
        request.resource.contentType == 'application/pdf' &&
        request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024;
    }

    // Module 4: Organized Certificate Storage Structure
    // Path: certificates/{userId}/{courseId}/{fileName} (e.g. certificate.pdf)
    match /certificates/{userId}/{courseId}/{fileName} {
      // Only the certificate owner (student) or an authorized administrator can read/download the PDF
      allow read: if isOwner(userId) || isAdmin();

      // Only an authorized administrator can upload/replace a PDF certificate (max 10 MB, application/pdf only)
      allow create, update: if isAdmin() &&
        fileName.matches('^[a-zA-Z0-9_\\-\\.]+\\.pdf$') &&
        isValidPdfUpload();

      // Only an authorized administrator can delete a certificate file
      allow delete: if isAdmin();
    }
  }
}
