# Configuração Oficial Hostinger (Apache / LiteSpeed) — Domínio: alhan.pro & Sublinks Administrativos
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forçar HTTPS seguro no domínio alhan.pro e subdomínios (admin.alhan.pro / www.alhan.pro)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^(?:www\.|admin\.|gestao\.)?alhan\.pro$ [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Suporte directo aos sublinks do Painel Administrativo (/gestao-alhan-sgi e /painel-admin) e rotas SPA
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|svg|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
